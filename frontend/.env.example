# Public backend location only. Never add server credentials to NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only operator proxy values. These are read by the Next.js server
# route, never shipped to the browser. Do NOT prefix them with NEXT_PUBLIC_.
ADMIN_PANEL_PASSWORD=
REGRET_API_ADMIN_SECRET=
REGRET_API_BASE_URL=
