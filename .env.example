ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=60

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_TOKENS=512
NVIDIA_REASONING_EFFORT=low

PAPER_EXECUTION_ENABLED=false
PUBLIC_AGENT_TRIGGER_ENABLED=false
EXECUTION_POSITION_PCT=0.02

MARKET_SCOUT_MIN_PRICE=5.0
MARKET_SCOUT_MIN_PREVIOUS_DAILY_VOLUME=500000
MARKET_SCOUT_MAX_DAILY_CHANGE_PCT=25.0

# Public-demo OBSERVE profile. The worker is a separate process.
AUTONOMOUS_AGENT_ENABLED=true
AUTONOMOUS_NEW_ENTRIES_ENABLED=true
AUTONOMOUS_CYCLE_SECONDS=300
AUTONOMOUS_MAX_CANDIDATES_PER_CYCLE=2
AUTONOMOUS_STALE_CYCLE_SECONDS=900

# Local development fallback. Railway backend and worker must both replace
# this with the same private PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./regret.db

# Comma-separated explicit browser origins. Replace/add the Vercel origin in
# Railway; wildcard origins are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vercel frontend only (configure in Vercel, never with server secrets):
# NEXT_PUBLIC_API_BASE_URL=https://<backend-domain>
